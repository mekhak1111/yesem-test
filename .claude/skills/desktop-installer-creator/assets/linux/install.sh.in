#!/bin/sh
# Installs @VENDOR_PACKAGE@ (if missing or older than @VENDOR_MIN@) and @PACKAGE@.
# Generated by installer/linux/build.sh (mode: @MODE@).
set -eu
cd "$(dirname "$0")"

MODE="@MODE@"
ARCH="$(dpkg --print-architecture)"
[ "$ARCH" = "@ARCH@" ] || { echo "This package is built for @ARCH@, this system is $ARCH." >&2; exit 1; }
[ -f SHA256SUMS ] && sha256sum -c --quiet SHA256SUMS

PKGS="./@APP_DEB@"
# Only a fully installed package counts ("ii"); removed-but-not-purged ("rc") doesn't.
have="$(dpkg-query -W -f='${db:Status-Abbrev} ${Version}' @VENDOR_PACKAGE@ 2>/dev/null | awk '$1 == "ii" { print $2 }' || true)"
if [ -z "$have" ] || dpkg --compare-versions "$have" lt "@VENDOR_MIN@"; then
  if [ "$MODE" = bundle ]; then
    PKGS="./@VENDOR_DEB@ $PKGS"
  else
    TMP="$(mktemp -d)"; trap 'rm -rf "$TMP"' EXIT
    echo "Downloading @VENDOR_PACKAGE@ from @VENDOR_URL@"
    curl -fsSL --retry 3 -o "$TMP/vendor.deb" "@VENDOR_URL@"
    echo "@VENDOR_SHA256@  $TMP/vendor.deb" | sha256sum -c --quiet -
    chmod 644 "$TMP/vendor.deb"; chmod 755 "$TMP"   # readable by apt's sandbox user
    PKGS="$TMP/vendor.deb $PKGS"
  fi
else
  echo "@VENDOR_PACKAGE@ $have is already installed."
fi

# One apt transaction: Depends between the local files is resolved, missing
# libraries come from the configured repositories.
sudo apt-get install -y $PKGS
# Keep the prerequisite when @PACKAGE@ is removed later (apt autoremove).
sudo apt-mark manual @VENDOR_PACKAGE@ >/dev/null
echo "@PACKAGE@ is installed."
